# Copy to .env and fill in what you use. Local engines (Parakeet, Gemma)
# need no keys; the server logs a warning at startup for missing cloud keys.

# ── Cloud engine credentials ──
ASSEMBLYAI_API_KEY=your_assemblyai_key_here
GEMINI_API_KEY=your_gemini_key_here          # or GOOGLE_API_KEY

# ── Engine selection (per-job UI choice overrides these defaults) ──
# DEFAULT_TRANSCRIPTION_ENGINE=assemblyai     # assemblyai | parakeet
# DEFAULT_SUMMARIZATION_ENGINE=gemini         # gemini | gemma

# ── Models ──
# ASSEMBLYAI_MODEL=universal-3-pro
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_SYSTEM_AUDIO_THINKING_LEVEL=low      # automated-message detection pass
# GEMINI_SUMMARY_THINKING_LEVEL=medium        # per-call summary
# GEMINI_CASE_REPORT_THINKING_LEVEL=medium    # case-report synthesis
# GEMMA_MODEL=unsloth/gemma-4-E2B-it-UD-MLX-4bit
# GEMMA_MAX_TOKENS=10240

# ── Concurrency (defaults sized for AssemblyAI pay-as-you-go + Gemini Tier 1) ──
# MAX_TRANSCRIPTION_CONCURRENT=50
# MAX_SUMMARIZATION_CONCURRENT=50
# MAX_PARAKEET_CONCURRENT=2
# ASSEMBLYAI_POLLING_INTERVAL=15              # seconds between status checks
# ASSEMBLYAI_TRANSCRIPTION_TIMEOUT_SEC=900

# ── Binaries (auto-detected on PATH / Homebrew when unset) ──
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# FLUIDAUDIO_PATH=/path/to/fluidaudiocli      # default: bin/fluidaudiocli
